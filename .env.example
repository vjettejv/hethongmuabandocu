# Existing deployment: retain its actual keys/passwords and named volumes.
# New installation: choose random keys/password; DB_USER=root and DB_PASSWORD=root password.
# Copy to ignored .env and fill privately; do not commit .env.
PYTHON_SECRET_KEY=
JWT_SECRET=
PYTHON_DB_USER=
PYTHON_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
NODE_ENV=development
MOCK_EMAIL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
